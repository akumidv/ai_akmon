{
  "dialect": "A pattern is matched against a repository-relative posix path. `**/` matches any number of leading directories (or none), `**` anywhere else matches anything including `/`, `*` and `?` stay inside one path segment, and a `[...]` class is passed through. An entry `@name` stands for the patterns of the set `name` declared before it.",
  "sets": {
    "standard_tree": [
      "ARCHETYPES.md",
      "BOOTSTRAP.md",
      "CAPABILITIES.md",
      "CHANGELOG.md",
      "LICENSE",
      "MODEL.md",
      "README.md",
      "agents/**",
      "common/**",
      "bin/**",
      "examples/**",
      "guardrails/**",
      "hooks/**",
      "pipelines/**",
      "profiles/**",
      "roles/**",
      "rules/**",
      "skills/**",
      "tools/**",
      "src/akmon/**"
    ],
    "shipped": ["@standard_tree", "js/**", "package.json"],
    "corpus": [
      "meta/conformance/**",
      "src/akmon/**",
      "common/**",
      "bin/**",
      "hooks/**",
      "tools/**",
      "js/**",
      "agents/agents.json",
      "rules/**",
      "profiles/ruff.toml",
      "package.json",
      "pyproject.toml",
      ".gitignore"
    ],
    "js_sources": ["**/*.mjs", "**/*.js", "**/*.ts"],
    "js_toolchain": ["package.json", "package-lock.json"]
  },
  "always": ["meta/self_ci.py", "meta/self_ci_legs.py", "meta/self_ci_legs.json"],
  "full_only": ["corpus-node", "fuzz"],
  "no_leg": [
    "meta/TASKS_ARCHIVE.md",
    "meta/MEASUREMENTS.md",
    "meta/ROADMAP.md",
    "meta/CONCEPT.md",
    "meta/D2_LEDGER.md",
    "meta/archive/**",
    "meta/reviews/**",
    "meta/experiments/**",
    "meta/tests/**",
    "docs/**"
  ],
  "legs": {
    "fixture": ["@shipped"],
    "wheel-smoke": ["@shipped", "pyproject.toml", "uv.lock", ".gitignore"],
    "npm-smoke": ["@shipped", "package-lock.json", ".gitignore", ".npmignore"],
    "always-loaded": ["@standard_tree", "meta/checks/always_loaded.py"],
    "capabilities": [
      "*.md",
      "roles/*.md",
      "pipelines/*.md",
      "profiles/*.md",
      "skills/**/*.md",
      "tools/**/*.md",
      "examples/*.md",
      "common/**",
      "meta/checks/capabilities.py"
    ],
    "canary": ["guardrails/**", "hooks/**", "common/**", "meta/checks/canary.py"],
    "decision-records": ["docs/adr/[0-9][0-9][0-9][0-9]-*.md", "meta/TASKS.md", "common/**", "meta/checks/decision_records.py"],
    "runtime": ["@shipped", "meta/checks/runtime.py"],
    "corpus": ["@corpus"],
    "js-deps": ["@js_toolchain"],
    "js-typecheck": ["js/**", "meta/conformance/**/*.mjs", "tsconfig.json", "@js_toolchain"],
    "js-unit": ["@shipped", "meta/conformance/**", ".aitna-root"],
    "js-lint": [
      "@js_sources",
      "**/*.cjs",
      "**/*.mts",
      "**/*.cts",
      "**/*.jsx",
      "**/*.tsx",
      ".oxlintrc.json",
      "profiles/oxlint.json",
      "@js_toolchain"
    ],
    "js-format": ["@js_sources", ".oxfmtrc.json", "@js_toolchain"],
    "corpus-node": ["@corpus"],
    "fuzz": ["@corpus"]
  }
}
