{
  "compilerOptions": {
    "strict": true,
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["js/**/*.mjs", "meta/conformance/**/*.mjs", "eslint.config.mjs"],
  "exclude": ["js/vendor", "node_modules"]
}
