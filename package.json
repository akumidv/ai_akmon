    "BOOTSTRAP.md",
    "CAPABILITIES.md",
    "CHANGELOG.md",
    "LICENSE",
    "MODEL.md",
    "README.md",
    "common",
    "bin",
    "examples",
    "guardrails",
    "hooks",
    "meta",
    "pipelines",
    "profiles",
    "roles",
    "skills",
    "tools",
    "src/akmon",
    "js",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "!**/.pytest_cache/**",
    "!**/.git/**"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "typescript": "7.0.2"
  }
