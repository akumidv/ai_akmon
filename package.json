{
  "name": "akmon",
  "version": "0.4.0",
  "description": "Akmon is AI-agent development standard, as an installable package.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "akmon": "js/akmon/cli.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./tools/model_profile/cli": "./js/tools/model_profile/cli.mjs",
    "./tools/model_routing/coverage_map": "./js/tools/model_routing/coverage_map.mjs",
    "./tools/model_routing/gate_pack": "./js/tools/model_routing/gate_pack.mjs",
    "./tools/model_routing/init": "./js/tools/model_routing/init.mjs",
    "./tools/model_routing/models": "./js/tools/model_routing/models.mjs",
    "./tools/model_routing/second_opinion": "./js/tools/model_routing/second_opinion.mjs",
    "./tools/model_routing/stats": "./js/tools/model_routing/stats.mjs",
    "./tools/park/park": "./js/tools/park/park.mjs",
    "./tools/release/release_check": "./js/tools/release/release_check.mjs",
    "./tools/tasks/archive": "./js/tools/tasks/archive.mjs"
  },
  "files": [
    "ARCHETYPES.md",
    "BOOTSTRAP.md",
    "CAPABILITIES.md",
    "CHANGELOG.md",
    "LICENSE",
    "MODEL.md",
    "README.md",
    "agents",
    "common",
    "bin",
    "examples",
    "guardrails",
    "hooks",
    "pipelines",
    "profiles",
    "roles",
    "skills",
    "tools",
    "src/akmon",
    "js",
    "!**/__pycache__/**",
    "!**/*.py[cod]",
    "!**/.pytest_cache/**",
    "!**/.git/**",
    "!**/*.test.mjs"
  ],
  "devDependencies": {
    "@types/node": "22.20.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  }
}
