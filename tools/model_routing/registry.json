{
  "anthropic": {
    "selection_policy": {
      "available_order": "weakest-to-strongest",
      "worker": "lowest",
      "mid": "next-after-worker",
      "reasoner": "orchestrator",
      "auditor": "highest",
      "orchestrator_floor": "opus"
    },
    "second_opinion": {
      "cli": "claude",
      "invoke": "claude -p --output-format text",
      "model_flag": "--model {model}",
      "report_dir": ".codex/second-opinion/"
    },
    "semantic_fallback": {
      "worker": "worker",
      "mid": "mid",
      "reasoner": "strongest",
      "auditor": "strongest",
      "orchestrator": "strongest"
    }
  },
  "openai": {
    "selection_policy": {
      "available_order": "weakest-to-strongest",
      "worker": "lowest",
      "mid": "next-after-worker",
      "reasoner": "orchestrator",
      "auditor": "highest",
      "orchestrator_floor": "highest"
    },
    "second_opinion": {
      "cli": "codex",
      "invoke": "codex exec",
      "report_dir": ".claude/second-opinion/"
    },
    "semantic_fallback": {
      "worker": "worker",
      "mid": "mid",
      "reasoner": "strongest",
      "auditor": "strongest",
      "orchestrator": "strongest"
    }
  },
  "context_pressure": {
    "window_default": 200000,
    "windows": {},
    "warn_ratios": [0.85, 0.95]
  },
  "task_kinds": {
    "explore-search": {"tier": "worker"},
    "summarize": {"tier": "worker"},
    "mech-edit": {"tier": "worker"},
    "test-scaffold": {"tier": "worker"},
    "doc-sync": {"tier": "worker"},
    "validate-loop": {"tier": "worker"},
    "implement-under-spec": {"tier": "worker", "rung": "mid"},
    "debug-deep": {"tier": "reasoner"},
    "design-fork": {"tier": "reasoner"},
    "quant-derivation": {"tier": "reasoner", "floor": "highest"},
    "plan-draft": {"tier": "reasoner"},
    "audit": {"tier": "auditor"},
    "independent-review": {"tier": "second-opinion"}
  },
  "second_opinion_policy": {
    "diversity_ladder": ["other-vendor", "same-vendor-other-model"],
    "never": "same-model"
  },
  "gate_triggers": {
    "review_min_findings": 3,
    "architect_min_options": 2
  },
  "cross_cutting_kinds": ["independent-review", "audit"],
  "role_task_kinds": {
    "review": ["explore-search", "summarize", "debug-deep", "plan-draft"],
    "architect": ["explore-search", "summarize", "design-fork", "quant-derivation", "plan-draft", "doc-sync"],
    "engineer": ["explore-search", "summarize", "mech-edit", "test-scaffold", "doc-sync", "validate-loop", "implement-under-spec", "debug-deep", "quant-derivation", "plan-draft"],
    "learn": ["explore-search", "summarize", "doc-sync"],
    "release": ["validate-loop", "doc-sync", "summarize"]
  }
}
