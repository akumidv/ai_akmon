{
  "anthropic": {
    "selection_policy": {
      "available_order": "weakest-to-strongest",
      "worker": "lowest",
      "mid": "next-after-worker",
      "reasoner": "orchestrator",
      "auditor": "highest",
      "orchestrator_floor": "opus"
    },
    "harness_rungs": ["haiku", "sonnet", "opus"],
    "auditor_only_rungs": ["fable"],
    "carrier": "claude",
    "semantic_fallback": {
      "worker": "worker",
      "mid": "mid",
      "reasoner": "strongest",
      "auditor": "strongest",
      "orchestrator": "strongest"
    }
  },
  "openai": {
    "selection_policy": {
      "available_order": "weakest-to-strongest",
      "worker": "lowest",
      "mid": "next-after-worker",
      "reasoner": "orchestrator",
      "auditor": "highest",
      "orchestrator_floor": "highest"
    },
    "harness_rungs": ["luna", "terra", "sol"],
    "auditor_only_rungs": ["astra"],
    "carrier": "codex",
    "semantic_fallback": {
      "worker": "worker",
      "mid": "mid",
      "reasoner": "strongest",
      "auditor": "strongest",
      "orchestrator": "strongest"
    }
  },
  "context_pressure": {
    "recommended_max": 200000,
    "recommended_max_by_alias": {},
    "info_ratio": 0.85
  },
  "task_kinds": {
    "explore-search": {
      "tier": "worker"
    },
    "summarize": {
      "tier": "worker"
    },
    "mech-edit": {
      "tier": "worker"
    },
    "test-scaffold": {
      "tier": "worker"
    },
    "doc-sync": {
      "tier": "worker"
    },
    "validate-loop": {
      "tier": "worker"
    },
    "implement-under-spec": {
      "tier": "worker",
      "rung": "mid"
    },
    "debug-deep": {
      "tier": "reasoner"
    },
    "design-fork": {
      "tier": "reasoner"
    },
    "quant-derivation": {
      "tier": "reasoner",
      "floor": "orchestrator_floor"
    },
    "plan-draft": {
      "tier": "reasoner"
    },
    "audit": {
      "tier": "auditor"
    },
    "independent-review": {
      "tier": "second-opinion"
    }
  },
  "second_opinion_policy": {
    "ladder": ["claude", "codex", "qwen", "opencode", "pi"],
    "families": {
      "claude": "Anthropic Claude models",
      "gpt": "OpenAI GPT models",
      "qwen": "Alibaba Qwen models",
      "gemini": "Google Gemini models"
    },
    "model_rule": "max",
    "never": "silently-same-model"
  },
  "providers": {
    "claude": {
      "operation": "review",
      "model_flag": "--model {model}",
      "family": "claude",
      "models": ["haiku", "sonnet", "opus"],
      "efforts": { "flag": "--effort {effort}", "levels": ["low", "medium", "high", "xhigh", "max"] },
      "report_dir": ".claude/second-opinion/"
    },
    "codex": {
      "operation": "review",
      "model_flag": "--model {model}",
      "family": "gpt",
      "models": ["luna", "terra", "sol"],
      "aliases": true,
      "catalog": { "file": "~/.codex/models_cache.json", "format": "codex-models-cache" },
      "efforts": {
        "flag": "-c 'model_reasoning_effort=\"{effort}\"'",
        "levels": ["low", "medium", "high", "xhigh", "max"]
      },
      "report_dir": ".codex/second-opinion/"
    },
    "qwen": {
      "operation": "review",
      "model_flag": "-m {model}",
      "prompt": "stdin",
      "family": "qwen",
      "models": [],
      "report_dir": ".qwen/second-opinion/"
    },
    "opencode": {
      "operation": "review",
      "model_flag": "-m {model}",
      "family": null,
      "models": [],
      "model_families": {},
      "report_dir": ".opencode/second-opinion/"
    },
    "pi": {
      "operation": "review",
      "model_flag": "--model {model}",
      "family": null,
      "models": [],
      "model_families": {},
      "efforts": {
        "flag": "--thinking {effort}",
        "levels": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
      },
      "report_dir": ".pi/second-opinion/"
    }
  },
  "gate_triggers": {
    "review_min_findings": 3,
    "architect_min_options": 2
  },
  "cross_cutting_kinds": [
    "independent-review",
    "audit"
  ],
  "role_task_kinds": {
    "review": [
      "explore-search",
      "summarize",
      "debug-deep",
      "plan-draft"
    ],
    "architect": [
      "explore-search",
      "summarize",
      "design-fork",
      "quant-derivation",
      "plan-draft",
      "doc-sync"
    ],
    "engineer": [
      "explore-search",
      "summarize",
      "mech-edit",
      "test-scaffold",
      "doc-sync",
      "validate-loop",
      "implement-under-spec",
      "debug-deep",
      "quant-derivation",
      "plan-draft"
    ],
    "learn": [
      "explore-search",
      "summarize",
      "doc-sync"
    ],
    "release": [
      "validate-loop",
      "doc-sync",
      "summarize"
    ]
  }
}
